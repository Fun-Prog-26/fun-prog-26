<quiz>
  <question type="multichoice">
    <name>
      <text>Purpose of loops</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[What is the main purpose of using a loop in programming?]]></text>
    </questiontext>
    <generalfeedback>
      <text/>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[To execute a set of statements only once]]></text>
      <feedback format="html">
        <text><![CDATA[That’s what happens without loops — they repeat, not run once.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[To repeat a set of statements multiple times]]></text>
      <feedback format="html">
        <text><![CDATA[Correct! Loops automate repetition in code.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[To compare two numbers]]></text>
      <feedback format="html">
        <text><![CDATA[Comparisons happen inside conditions, not loops themselves.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[To define a variable]]></text>
      <feedback format="html">
        <text><![CDATA[Variables can exist inside loops, but that’s not their main purpose.]]></text>
      </feedback>
    </answer>
  </question>
