<?xml version="1.0" encoding="UTF-8"?>
<quiz>

  <question type="category">
    <category>
      <text>$course$/Topic4-2-Lambda-Calculus</text>
    </category>
  </question>

  <!-- Q1 -->
  <question type="multichoice">
    <name><text>Lambda Calculus Purpose</text></name>
    <questiontext format="html">
      <text><![CDATA[
What is the lambda calculus primarily used for?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>A model of computation</text>
      <feedback><text>Correct. Lambda calculus formalises computation via function application.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>A programming language syntax</text>
      <feedback><text>It inspired languages, but is not itself a programming language.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>A type system</text>
      <feedback><text>Types are not part of the untyped lambda calculus.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>A machine architecture</text>
      <feedback><text>Lambda calculus is abstract, not hardware-based.</text></feedback>
    </answer>
  </question>

  <!-- Q2 -->
  <question type="multichoice">
    <name><text>Haskell and Lambda Calculus</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why is Haskell described as a <em>pure</em> functional language?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>All features can be translated into lambda expressions</text>
      <feedback><text>Correct. This is the core reason given in the slides.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>It does not allow recursion</text>
      <feedback><text>Haskell supports recursion extensively.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>It avoids functions</text>
      <feedback><text>Functions are fundamental in Haskell.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>It runs only mathematical code</text>
      <feedback><text>Purity relates to side effects, not subject matter.</text></feedback>
    </answer>
  </question>

  <!-- Q3 -->
  <question type="multichoice">
    <name><text>Lambda Abstraction Structure</text></name>
    <questiontext format="html">
      <text><![CDATA[
In the expression <code>λx. x + 1</code>, what is <code>x</code>?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>A bound variable</text>
      <feedback><text>Correct. It is bound by the lambda.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>A free variable</text>
      <feedback><text>Free variables are not bound by a lambda.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>An argument value</text>
      <feedback><text>Arguments appear during application, not abstraction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>A constant</text>
      <feedback><text>Constants do not vary with application.</text></feedback>
    </answer>
  </question>

  <!-- Q4 -->
  <question type="multichoice">
    <name><text>Alpha Equivalence</text></name>
    <questiontext format="html">
      <text><![CDATA[
Which expressions are alpha equivalent to <code>λx. x</code>?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text><code>λapple. apple</code></text>
      <feedback><text>Correct. Variable names are irrelevant if structure is unchanged.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>λx. x + 1</code></text>
      <feedback><text>The body is different.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>λx. y</code></text>
      <feedback><text>The variable usage differs.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>λx. x x</code></text>
      <feedback><text>The structure is different.</text></feedback>
    </answer>
  </question>

  <!-- Q5 -->
  <question type="multichoice">
    <name><text>Beta Reduction Definition</text></name>
    <questiontext format="html">
      <text><![CDATA[
What is beta reduction?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>Substituting an argument for a bound variable</text>
      <feedback><text>Correct. This is the essence of beta reduction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Renaming variables</text>
      <feedback><text>This describes alpha conversion.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Evaluating arithmetic</text>
      <feedback><text>Arithmetic happens after reduction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Removing free variables</text>
      <feedback><text>Free variables are not removed.</text></feedback>
    </answer>
  </question>

  <!-- Q6 -->
  <question type="multichoice">
    <name><text>Identity Function</text></name>
    <questiontext format="html">
      <text><![CDATA[
What is the result of <code>(λx. x) 2</code>?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>2</text>
      <feedback><text>Correct. The identity function returns its argument.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>x</code></text>
      <feedback><text>The variable is replaced during reduction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>An error</text>
      <feedback><text>This is a valid reduction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>λx. x</code></text>
      <feedback><text>The function is applied, not returned.</text></feedback>
    </answer>
  </question>

  <!-- Q7 -->
  <question type="multichoice">
    <name><text>Application Associativity</text></name>
    <questiontext format="html">
      <text><![CDATA[
How are applications associated in the lambda calculus?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>Left associative</text>
      <feedback><text>Correct. Applications group from the left.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Right associative</text>
      <feedback><text>This would change evaluation order.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Based on precedence</text>
      <feedback><text>There is only one application rule.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Randomly</text>
      <feedback><text>Association is deterministic.</text></feedback>
    </answer>
  </question>

  <!-- Q8 -->
  <question type="multichoice">
    <name><text>Free Variables</text></name>
    <questiontext format="html">
      <text><![CDATA[
In <code>λx. x * y</code>, which variable is free?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text><code>y</code></text>
      <feedback><text>Correct. It is not bound by any lambda.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>x</code></text>
      <feedback><text><code>x</code> is bound by the lambda.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Both</text>
      <feedback><text>Only <code>y</code> is free.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Neither</text>
      <feedback><text>At least one variable is free.</text></feedback>
    </answer>
  </question>

  <!-- Q9 -->
  <question type="multichoice">
    <name><text>Irreducible Expressions</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why can <code>z y</code> not be reduced further?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>There are no lambdas left to apply</text>
      <feedback><text>Correct. Reduction requires an abstraction.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The syntax is invalid</text>
      <feedback><text>The syntax is valid.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Variables must be numbers</text>
      <feedback><text>Variables may represent any expression.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Applications must be nested</text>
      <feedback><text>The nesting is already valid.</text></feedback>
    </answer>
  </question>

  <!-- Q10 -->
  <question type="multichoice">
    <name><text>Multiple Arguments</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why does <code>λx y. x y</code> represent two arguments?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>It expands to nested lambdas</text>
      <feedback><text>Correct. It means <code>λx. (λy. x y)</code>.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Lambdas bind lists of variables</text>
      <feedback><text>Each lambda binds only one variable.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>It is a special Haskell rule</text>
      <feedback><text>This comes from the lambda calculus.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>It uses tuples</text>
      <feedback><text>No tuples are involved.</text></feedback>
    </answer>
  </question>

  <!-- Q11 -->
  <question type="multichoice">
    <name><text>Lambdas and if</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why can <code>if</code> appear inside a lambda in Haskell?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>Because <code>if</code> is an expression</text>
      <feedback><text>Correct. It always returns a value.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Because lambdas ignore syntax rules</text>
      <feedback><text>All expressions must still be valid.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Because Haskell rewrites it automatically</text>
      <feedback><text>No rewriting is implied.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Because lambdas are statements</text>
      <feedback><text>Lambdas are expressions, not statements.</text></feedback>
    </answer>
  </question>

  <!-- Q12 -->
  <question type="multichoice">
    <name><text>Missing else Error</text></name>
    <questiontext format="html">
      <text><![CDATA[
What is wrong with <code>\\x -> if x > 0 then x</code>?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>The <code>if</code> expression has no else branch</text>
      <feedback><text>Correct. All cases must return a value.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The lambda syntax is wrong</text>
      <feedback><text>The lambda syntax is correct.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The comparison is invalid</text>
      <feedback><text>The comparison is valid.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The variable is unbound</text>
      <feedback><text><code>x</code> is correctly bound.</text></feedback>
    </answer>
  </question>

  <!-- Q13 -->
  <question type="multichoice">
    <name><text>Wrong Application</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why is <code>\\x y -> if x < y then -1 else 1 3 4</code> incorrect?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text>The arguments are applied to the result, not the lambda</text>
      <feedback><text>Correct. Parentheses are required.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The lambda binds too many variables</text>
      <feedback><text>Binding two variables is valid.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The comparison is wrong</text>
      <feedback><text>The comparison itself is fine.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Integers cannot be applied</text>
      <feedback><text>Integers may appear as arguments.</text></feedback>
    </answer>
  </question>

  <!-- Q14 -->
  <question type="multichoice">
    <name><text>Single Variable Binding</text></name>
    <questiontext format="html">
      <text><![CDATA[
What is wrong with <code>\\xy -> x + y</code>?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text><code>xy</code> is treated as one variable</text>
      <feedback><text>Correct. Lambdas bind exactly one variable.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Operators cannot be used</text>
      <feedback><text>Operators are allowed.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The lambda is missing parentheses</text>
      <feedback><text>Parentheses are not the issue.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>Arithmetic is not allowed</text>
      <feedback><text>Arithmetic is allowed.</text></feedback>
    </answer>
  </question>

  <!-- Q15 -->
  <question type="multichoice">
    <name><text>Unbound Variable Error</text></name>
    <questiontext format="html">
      <text><![CDATA[
Why is <code>\\y -> if x < y then -1 else 1</code> invalid?
]]></text>
    </questiontext>
    <shuffleanswers>true</shuffleanswers>
    <single>true</single>
    <answer fraction="100">
      <text><code>x</code> is not bound by any lambda</text>
      <feedback><text>Correct. Variables must be bound before use.</text></feedback>
    </answer>
    <answer fraction="0">
      <text><code>if</code> cannot appear in lambdas</text>
      <feedback><text><code>if</code> is an expression.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The comparison is invalid</text>
      <feedback><text>The comparison itself is valid.</text></feedback>
    </answer>
    <answer fraction="0">
      <text>The lambda binds too many variables</text>
      <feedback><text>Only one variable is bound.</text></feedback>
    </answer>
  </question>

</quiz>
