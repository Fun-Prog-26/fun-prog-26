  <question type="multichoice">
    <name><text>Q1 Lambda Syntax</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the correct syntax for a lambda in Haskell?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Lambdas use \ and ->.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.33</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100"><text><![CDATA[\x -> x + 1]]></text><feedback><text>Correct.</text></feedback></answer>
    <answer fraction="0"><text>x -> x + 1</text><feedback><text>Missing backslash.</text></feedback></answer>
    <answer fraction="0"><text>lambda x = x + 1</text><feedback><text>No lambda keyword in Haskell.</text></feedback></answer>
    <answer fraction="0"><text>\x = x + 1</text><feedback><text>Use -> not =.</text></feedback></answer>
  </question>

